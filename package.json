{
  "name": "summitstreet.github.io",
  "version": "2.0.0",
  "description": "https://summitstreet.tech",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:clean": "shx rm -rf dist/ && shx rm -rf docs/",
    "build:pre": "tsx scripts/pre-build.ts",
    "build:web": "vite build",
    "build": "npm run format && npm run lint && npm run build:pre && npm run build:web",
    "dev": "npm run build:pre && vite dev",
    "format": "prettier --write .",
    "lint:html": "npm run lint:html:structure && npm run lint:html:scripts",
    "lint:html:structure": "eslint --config eslint.structure.config.js \"src/**/*.html\"",
    "lint:html:scripts": "eslint --config eslint.scripts.config.js \"src/**/*.html\"",
    "lint:css": "stylelint \"src/**/*.html\"",
    "lint": "eslint . && npm run lint:html && npm run lint:css"
  },
  "keywords": [],
  "author": "David Padgett <https://github.com/SummitStreet>",
  "devDependencies": {
    "@html-eslint/eslint-plugin": "0.64.0",
    "@html-eslint/parser": "0.64.0",
    "@summitstreet/svelte-ui-sdk": "2.0.0",
    "@summitstreet/web-app-sdk-ts": "2.0.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "26.1.2",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.9.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "svelte": "5.56.8",
    "ts-node": "10.9.2",
    "tsx": "^4.23.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {}
}
